# Public URL of the live site (no trailing slash). Used for canonical URLs, sitemap,
# Open Graph and product links in WhatsApp messages.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --- Inquiry forms (server-side only; never prefix these with NEXT_PUBLIC_) ---
# API key from https://resend.com (Dashboard → API Keys). Without it, forms show an
# error with WhatsApp/email fallbacks instead of a success message.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Tech Pouch <inquiries@your-domain.com>".
# If empty, Resend's test sender is used (it can only deliver to your Resend account email).
INQUIRY_FROM_EMAIL=
# Where inquiries are delivered (comma-separated). Defaults to techpouch123@gmail.com.
INQUIRY_TO_EMAIL=

# --- Optional: Google Search Console & Analytics ---
# Token from Search Console's "HTML tag" verification method (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Update the privacy policy when enabling.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
